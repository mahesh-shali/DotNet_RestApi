{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:${dbServer},1433;Initial Catalog={dbName};Persist Security Info=False;User ID={dbUser};Password={dbPassword};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  // "Kestrel": {
  //   "Endpoints": {
  //     "Https": {
  //       "Url": "https://0.0.0.0:5000/",
  //       "Certificate": {
  //         "Path": "/etc/ssl/certs/api.crt",
  //         "KeyPath": "/etc/ssl/private/api.key"
  //       }
  //     }
  //   }
  // },
  "Jwt": {
    "Key": "${key}",
    "Issuer": "${Issuer}",
    "Audience": "${Audience}"
  },
  "Authentication": {
    "Google": {
      "ClientId": "${ClientId}",
      "ClientSecret": "${ClientSecret}"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
